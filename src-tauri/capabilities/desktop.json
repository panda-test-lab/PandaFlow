{
  "$schema": "../definitions/capability-schema.json",
  "identifier": "main-capability",
  "description": "Kompakte Berechtigungen fuer PandaFlow",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPLOG/**" }]
    },
    "core:path:default",
    "updater:default"
  ]
}